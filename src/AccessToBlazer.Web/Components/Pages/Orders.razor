@page "/orders"
@rendermode InteractiveServer
@using AccessToBlazer.Web.Data
@using AccessToBlazer.Web.Models
@using AccessToBlazer.Web.Components.Shared
@inject IDbContextFactory<SampleDbContext> DbFactory

<PageTitle>Orders</PageTitle>

<h1>Orders</h1>
<p class="text-muted">
    Ported from the Access <strong>Orders</strong> form, where <em>CustomerID</em> and
    <em>ProductID</em> were combo-box lookups.
</p>

@if (savedMessage is not null)
{
    <div class="alert alert-success py-2">@savedMessage</div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger py-2">@errorMessage</div>
}

<div class="row">
    <div class="col-md-7">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th style="width:4rem">ID</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th class="text-end">Qty</th>
                    <th>Date</th>
                    <th style="width:9rem"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in OrderList ?? [])
                {
                    <tr class="@(editing is not null && editing.OrderId == order.OrderId ? "table-primary" : null)">
                        <td>@order.OrderId</td>
                        <td>@order.CustomerName</td>
                        <td>@order.ProductName</td>
                        <td class="text-end">@order.Quantity</td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(order)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(order)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="CurrentPage" TotalCount="TotalCount" PageChanged="GoToPageAsync" />
        <button class="btn btn-success" @onclick="AddNew">Add order</button>
    </div>

    <div class="col-md-5">
        @if (editing is null)
        {
            <div class="alert alert-secondary">Select <em>Edit</em> or <em>Add order</em> to change a record.</div>
        }
        else
        {
            <div class="card">
                <div class="card-header">@(editing.OrderId == 0 ? "New order" : $"Order #{editing.OrderId}")</div>
                <div class="card-body">
                    <EditForm Model="editing" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Customer</label>
                            <InputSelect class="form-select" @bind-Value="editing.CustomerId">
                                <option value="0">-- select --</option>
                                @foreach (var customer in CustomerList ?? [])
                                {
                                    <option value="@customer.CustomerId">@customer.CustomerName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => editing.CustomerId" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Product</label>
                            <InputSelect class="form-select" @bind-Value="editing.ProductId">
                                <option value="0">-- select --</option>
                                @foreach (var product in ProductList ?? [])
                                {
                                    <option value="@product.ProductId">@product.ProductName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => editing.ProductId" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Quantity</label>
                            <InputNumber class="form-control" @bind-Value="editing.Quantity" />
                            <ValidationMessage For="() => editing.Quantity" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Order date</label>
                            <InputDate class="form-control" @bind-Value="editing.OrderDate" />
                        </div>
                        @foreach (var message in validationErrors)
                        {
                            <div class="text-danger small mb-2">@message</div>
                        }
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // Persisted from the prerender pass so the circuit does not query again.
    [PersistentState]
    public List<OrderRow>? OrderList { get; set; }

    [PersistentState]
    public int CurrentPage { get; set; }

    [PersistentState]
    public int TotalCount { get; set; }

    [PersistentState]
    public List<Customer>? CustomerList { get; set; }

    [PersistentState]
    public List<Product>? ProductList { get; set; }

    private Order? editing;
    private string? savedMessage;
    private string? errorMessage;
    private IReadOnlyList<string> validationErrors = [];

    protected override async Task OnInitializedAsync()
    {
        if (OrderList is null || CustomerList is null || ProductList is null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            CustomerList = await db.Customers.AsNoTracking().OrderBy(c => c.CustomerName).ToListAsync();
            ProductList = await db.Products.AsNoTracking().OrderBy(p => p.ProductName).ToListAsync();
            await LoadAsync();
        }
    }

    // Only the orders change on save/delete; the lookup lists are loaded once.
    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        TotalCount = await db.Orders.CountAsync();
        CurrentPage = Paging.ClampPage(CurrentPage, TotalCount);
        OrderList = await db.Orders
            .AsNoTracking()
            .OrderByDescending(o => o.OrderDate).ThenByDescending(o => o.OrderId)
            .ForPage(CurrentPage)
            .Select(o => new OrderRow(
                o.OrderId, o.CustomerId, o.Customer!.CustomerName, o.ProductId, o.Product!.ProductName,
                o.Quantity, o.OrderDate, o.RowVersion))
            .ToListAsync();
    }

    private async Task GoToPageAsync(int newPage)
    {
        CurrentPage = newPage;
        await LoadAsync();
    }

    private void AddNew()
    {
        validationErrors = [];
        savedMessage = null;
        errorMessage = null;
        editing = new Order { OrderDate = DateTime.Today };
    }

    private void Edit(OrderRow order)
    {
        validationErrors = [];
        savedMessage = null;
        errorMessage = null;
        editing = new Order
        {
            OrderId = order.OrderId,
            CustomerId = order.CustomerId,
            ProductId = order.ProductId,
            Quantity = order.Quantity,
            OrderDate = order.OrderDate,
            RowVersion = order.RowVersion
        };
    }

    private void Cancel()
    {
        editing = null;
        validationErrors = [];
    }

    private async Task Save()
    {
        if (editing is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // Server-side rules the annotations cannot express: stock and date range.
        var stock = await db.Products
            .Where(p => p.ProductId == editing.ProductId)
            .Select(p => (int?)p.UnitsInStock)
            .SingleOrDefaultAsync();
        if (stock is null)
        {
            validationErrors = ["The selected product no longer exists."];
            return;
        }

        validationErrors = OrderValidator.Validate(editing.Quantity, editing.OrderDate, stock.Value, DateTime.Today);
        if (validationErrors.Count > 0)
        {
            return;
        }

        if (editing.OrderId == 0)
        {
            db.Orders.Add(editing);
        }
        else
        {
            db.Orders.Update(editing);
        }

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            await ReportConflictAsync();
            return;
        }
        catch (DbUpdateException)
        {
            // Typically a customer or product deleted since the lists were loaded.
            errorMessage = "Could not save the order. Check that the customer and product still exist.";
            return;
        }

        savedMessage = "Saved order.";
        errorMessage = null;
        validationErrors = [];
        editing = null;
        await LoadAsync();
    }

    private async Task Delete(OrderRow order)
    {
        savedMessage = null;
        errorMessage = null;

        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.Orders.FindAsync(order.OrderId);
        if (entity is not null)
        {
            // Delete only if the row is still the version the user saw.
            db.Entry(entity).Property(o => o.RowVersion).OriginalValue = order.RowVersion;
            db.Orders.Remove(entity);
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                await ReportConflictAsync();
                return;
            }
        }

        if (editing?.OrderId == order.OrderId)
        {
            editing = null;
        }

        savedMessage = "Deleted order.";
        await LoadAsync();
    }

    private async Task ReportConflictAsync()
    {
        validationErrors = [];
        errorMessage = "The order was changed or deleted by someone else, so it was not saved. The list has been reloaded.";
        editing = null;
        await LoadAsync();
    }
}