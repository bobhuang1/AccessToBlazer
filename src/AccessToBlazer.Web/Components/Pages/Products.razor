@page "/products"
@rendermode InteractiveServer
@using AccessToBlazer.Web.Data
@using AccessToBlazer.Web.Models
@using AccessToBlazer.Web.Components.Shared
@inject IDbContextFactory<SampleDbContext> DbFactory

<PageTitle>Products</PageTitle>

<h1>Products</h1>
<p class="text-muted">Ported from the Access <strong>Products</strong> form.</p>

@if (savedMessage is not null)
{
    <div class="alert alert-success py-2">@savedMessage</div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger py-2">@errorMessage</div>
}

<div class="row">
    <div class="col-md-7">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th style="width:4rem">ID</th>
                    <th>Name</th>
                    <th class="text-end">Unit price</th>
                    <th class="text-end">In stock</th>
                    <th style="width:9rem"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in ProductList ?? [])
                {
                    <tr class="@(editing is not null && editing.ProductId == product.ProductId ? "table-primary" : null)">
                        <td>@product.ProductId</td>
                        <td>@product.ProductName</td>
                        <td class="text-end">@product.UnitPrice.ToString("C")</td>
                        <td class="text-end">@product.UnitsInStock</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(product)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(product)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="CurrentPage" TotalCount="TotalCount" PageChanged="GoToPageAsync" />
        <button class="btn btn-success" @onclick="AddNew">Add product</button>
    </div>

    <div class="col-md-5">
        @if (editing is null)
        {
            <div class="alert alert-secondary">Select <em>Edit</em> or <em>Add product</em> to change a record.</div>
        }
        else
        {
            <div class="card">
                <div class="card-header">@(editing.ProductId == 0 ? "New product" : $"Product #{editing.ProductId}")</div>
                <div class="card-body">
                    <EditForm Model="editing" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="editing.ProductName" />
                            <ValidationMessage For="() => editing.ProductName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Unit price</label>
                            <InputNumber class="form-control" @bind-Value="editing.UnitPrice" />
                            <ValidationMessage For="() => editing.UnitPrice" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Units in stock</label>
                            <InputNumber class="form-control" @bind-Value="editing.UnitsInStock" />
                            <ValidationMessage For="() => editing.UnitsInStock" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // Persisted from the prerender pass so the circuit does not query again.
    [PersistentState]
    public List<Product>? ProductList { get; set; }

    [PersistentState]
    public int CurrentPage { get; set; }

    [PersistentState]
    public int TotalCount { get; set; }

    private Product? editing;
    private string? savedMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (ProductList is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        TotalCount = await db.Products.CountAsync();
        CurrentPage = Paging.ClampPage(CurrentPage, TotalCount);
        ProductList = await db.Products
            .AsNoTracking()
            .OrderBy(p => p.ProductName).ThenBy(p => p.ProductId)
            .ForPage(CurrentPage)
            .ToListAsync();
    }

    private async Task GoToPageAsync(int newPage)
    {
        CurrentPage = newPage;
        await LoadAsync();
    }

    private void AddNew()
    {
        savedMessage = null;
        errorMessage = null;
        editing = new Product();
    }

    private void Edit(Product product)
    {
        savedMessage = null;
        errorMessage = null;
        editing = new Product
        {
            ProductId = product.ProductId,
            ProductName = product.ProductName,
            UnitPrice = product.UnitPrice,
            UnitsInStock = product.UnitsInStock,
            RowVersion = product.RowVersion
        };
    }

    private void Cancel() => editing = null;

    private async Task Save()
    {
        if (editing is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (editing.ProductId == 0)
        {
            db.Products.Add(editing);
        }
        else
        {
            db.Products.Update(editing);
        }

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            await ReportConflictAsync($"\"{editing.ProductName}\"");
            return;
        }
        catch (DbUpdateException)
        {
            errorMessage = $"Could not save \"{editing.ProductName}\".";
            return;
        }

        savedMessage = $"Saved \"{editing.ProductName}\".";
        errorMessage = null;
        editing = null;
        await LoadAsync();
    }

    private async Task Delete(Product product)
    {
        savedMessage = null;
        errorMessage = null;

        await using var db = await DbFactory.CreateDbContextAsync();

        // Access enforces referential integrity too, but surfaces it as an
        // unhandled record-not-deletable error. Here we check first so the
        // user gets a readable message instead of a DbUpdateException.
        var orderCount = await db.Orders.CountAsync(o => o.ProductId == product.ProductId);
        if (orderCount > 0)
        {
            errorMessage = $"Cannot delete \"{product.ProductName}\": {orderCount} order(s) still reference it. Delete those orders first.";
            return;
        }

        var entity = await db.Products.FindAsync(product.ProductId);
        if (entity is not null)
        {
            // Delete only if the row is still the version the user saw.
            db.Entry(entity).Property(p => p.RowVersion).OriginalValue = product.RowVersion;
            db.Products.Remove(entity);
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                await ReportConflictAsync($"\"{product.ProductName}\"");
                return;
            }
            catch (DbUpdateException)
            {
                // An order was added after the check above (FK Restrict).
                errorMessage = $"Cannot delete \"{product.ProductName}\": it is still referenced by an order.";
                return;
            }
        }

        if (editing?.ProductId == product.ProductId)
        {
            editing = null;
        }

        savedMessage = $"Deleted \"{product.ProductName}\".";
        await LoadAsync();
    }

    private async Task ReportConflictAsync(string what)
    {
        errorMessage = $"{what} was changed or deleted by someone else, so it was not saved. The list has been reloaded.";
        editing = null;
        await LoadAsync();
    }
}