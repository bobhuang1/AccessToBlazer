@page "/customers"
@rendermode InteractiveServer
@using AccessToBlazer.Web.Data
@using AccessToBlazer.Web.Models
@using AccessToBlazer.Web.Components.Shared
@inject IDbContextFactory<SampleDbContext> DbFactory

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>
<p class="text-muted">Ported from the Access <strong>Customers</strong> form.</p>

@if (savedMessage is not null)
{
    <div class="alert alert-success py-2">@savedMessage</div>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger py-2">@errorMessage</div>
}

<div class="row">
    <div class="col-md-7">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th style="width:4rem">ID</th>
                    <th>Name</th>
                    <th>City</th>
                    <th>Phone</th>
                    <th style="width:9rem"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in CustomerList ?? [])
                {
                    <tr class="@(editing is not null && editing.CustomerId == customer.CustomerId ? "table-primary" : null)">
                        <td>@customer.CustomerId</td>
                        <td>@customer.CustomerName</td>
                        <td>@customer.City</td>
                        <td>@customer.Phone</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(customer)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(customer)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager Page="CurrentPage" TotalCount="TotalCount" PageChanged="GoToPageAsync" />
        <button class="btn btn-success" @onclick="AddNew">Add customer</button>
    </div>

    <div class="col-md-5">
        @if (editing is null)
        {
            <div class="alert alert-secondary">Select <em>Edit</em> or <em>Add customer</em> to change a record.</div>
        }
        else
        {
            <div class="card">
                <div class="card-header">@(editing.CustomerId == 0 ? "New customer" : $"Customer #{editing.CustomerId}")</div>
                <div class="card-body">
                    <EditForm Model="editing" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="editing.CustomerName" />
                            <ValidationMessage For="() => editing.CustomerName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">City</label>
                            <InputText class="form-control" @bind-Value="editing.City" />
                            <ValidationMessage For="() => editing.City" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <InputText class="form-control" @bind-Value="editing.Phone" />
                            <ValidationMessage For="() => editing.Phone" />
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    </EditForm>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // Persisted from the prerender pass so the circuit does not query again.
    [PersistentState]
    public List<Customer>? CustomerList { get; set; }

    [PersistentState]
    public int CurrentPage { get; set; }

    [PersistentState]
    public int TotalCount { get; set; }

    private Customer? editing;
    private string? savedMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (CustomerList is null)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        TotalCount = await db.Customers.CountAsync();
        CurrentPage = Paging.ClampPage(CurrentPage, TotalCount);
        CustomerList = await db.Customers
            .AsNoTracking()
            .OrderBy(c => c.CustomerName).ThenBy(c => c.CustomerId)
            .ForPage(CurrentPage)
            .ToListAsync();
    }

    private async Task GoToPageAsync(int newPage)
    {
        CurrentPage = newPage;
        await LoadAsync();
    }

    private void AddNew()
    {
        savedMessage = null;
        errorMessage = null;
        editing = new Customer();
    }

    private void Edit(Customer customer)
    {
        savedMessage = null;
        errorMessage = null;
        editing = new Customer
        {
            CustomerId = customer.CustomerId,
            CustomerName = customer.CustomerName,
            City = customer.City,
            Phone = customer.Phone,
            RowVersion = customer.RowVersion
        };
    }

    private void Cancel() => editing = null;

    private async Task Save()
    {
        if (editing is null)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (editing.CustomerId == 0)
        {
            db.Customers.Add(editing);
        }
        else
        {
            db.Customers.Update(editing);
        }

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            await ReportConflictAsync($"\"{editing.CustomerName}\"");
            return;
        }
        catch (DbUpdateException)
        {
            errorMessage = $"Could not save \"{editing.CustomerName}\".";
            return;
        }

        savedMessage = $"Saved \"{editing.CustomerName}\".";
        errorMessage = null;
        editing = null;
        await LoadAsync();
    }

    private async Task Delete(Customer customer)
    {
        savedMessage = null;
        errorMessage = null;

        await using var db = await DbFactory.CreateDbContextAsync();

        var orderCount = await db.Orders.CountAsync(o => o.CustomerId == customer.CustomerId);
        if (orderCount > 0)
        {
            errorMessage = $"Cannot delete \"{customer.CustomerName}\": {orderCount} order(s) still reference it. Delete those orders first.";
            return;
        }

        var entity = await db.Customers.FindAsync(customer.CustomerId);
        if (entity is not null)
        {
            // Delete only if the row is still the version the user saw.
            db.Entry(entity).Property(c => c.RowVersion).OriginalValue = customer.RowVersion;
            db.Customers.Remove(entity);
            try
            {
                await db.SaveChangesAsync();
            }
            catch (DbUpdateConcurrencyException)
            {
                await ReportConflictAsync($"\"{customer.CustomerName}\"");
                return;
            }
            catch (DbUpdateException)
            {
                // An order was added after the check above (FK Restrict).
                errorMessage = $"Cannot delete \"{customer.CustomerName}\": it is still referenced by an order.";
                return;
            }
        }

        if (editing?.CustomerId == customer.CustomerId)
        {
            editing = null;
        }

        savedMessage = $"Deleted \"{customer.CustomerName}\".";
        await LoadAsync();
    }

    private async Task ReportConflictAsync(string what)
    {
        errorMessage = $"{what} was changed or deleted by someone else, so it was not saved. The list has been reloaded.";
        editing = null;
        await LoadAsync();
    }
}